# Write exact versions, not caret ranges, when adding or updating a dependency.
#
# This is a wallet: a malicious patch release of any client-side dependency can
# reach mnemonics and signing. package-lock.json already pins exact versions and
# CI installs with `npm ci`, so builds are reproducible today — this stops new
# caret ranges creeping back in via `npm install <pkg>` and keeps every version
# change an explicit, reviewable diff.
save-exact=true
