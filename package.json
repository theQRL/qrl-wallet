{
  "name": "qrl-wallet",
  "version": "1.9.2",
  "description": "QRL Wallet",
  "author": "The QRL Contributors",
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "7.29.10",
    "@grpc/grpc-js": "1.14.6",
    "@grpc/proto-loader": "0.8.1",
    "@ledgerhq/devices": "8.18.0",
    "@ledgerhq/hw-transport-node-hid": "6.33.5",
    "@ledgerhq/hw-transport-webusb": "6.35.0",
    "@theqrl/explorer-helpers": "2.8.2",
    "@theqrl/hw-app-qrl": "6.28.3",
    "@theqrl/nft-providers": "1.1.0",
    "@theqrl/qrl-proto-sha256": "3.5.0",
    "@theqrl/validate-qrl-address": "3.0.1",
    "@theqrl/wallet-helpers": "4.0.0",
    "aes256": "1.1.0",
    "async": "3.2.6",
    "bignumber.js": "9.3.1",
    "browserify-aes": "1.2.0",
    "core-js": "3.50.0",
    "crypto-browserify": "3.12.1",
    "crypto-js": "4.2.0",
    "json-formatter-js": "2.5.23",
    "json-stable-stringify": "1.3.0",
    "mathjs": "15.2.0",
    "meteor-better-storage": "2.0.2",
    "meteor-node-stubs": "1.2.30",
    "qrllib": "1.3.2",
    "randombytes": "2.1.0",
    "sha256": "0.2.0",
    "stream-browserify": "3.0.0",
    "tmp": "0.2.7",
    "vue": "3.5.43"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theQRL/qrl-wallet.git"
  },
  "keywords": [
    "QRL",
    "blockchain"
  ],
  "bugs": {
    "url": "https://github.com/theQRL/qrl-wallet/issues"
  },
  "homepage": "https://github.com/theQRL/qrl-wallet#readme",
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@tailwindcss/cli": "4.3.3",
    "@theqrl/electrify-qrl": "1.1.3",
    "autoprefixer": "10.6.1",
    "concurrently": "9.2.5",
    "daisyui": "5.5.18",
    "electron-builder": "26.15.3",
    "eslint": "8.57.1",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-meteor": "7.3.0",
    "jiti": "2.7.0",
    "node-gyp": "12.4.0",
    "postcss": "8.5.29",
    "run-script-os": "1.1.6",
    "tailwindcss": "4.3.3"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0",
    "shelljs": "0.8.5"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./private/tailwind/input.css -o ./public/tailwind-output.css",
    "build:css:watch": "tailwindcss -i ./private/tailwind/input.css -o ./public/tailwind-output.css --watch",
    "build:qrllib-worker": "node .scripts/sync-qrllib-worker.js",
    "verify:qrllib-worker": "node .scripts/sync-qrllib-worker.js --check",
    "audit:migration": "node .scripts/migration-audit.js",
    "verify:pins": "node .scripts/verify-dependency-pins.js",
    "start": "meteor",
    "dev": "concurrently \"npm run build:css:watch\" \"meteor\"",
    "test": "echo null",
    "postinstall": "node .scripts/patch-ledger-exports.js",
    "cleanDist": "run-script-os",
    "cleanDist:darwin": "mkdir -p ./.electrify/.dist && find ./.electrify/.dist -mindepth 1 -maxdepth 1 -type d -name 'QRLWallet-darwin-*' -exec rm -rf {} +",
    "cleanDist:linux": "mkdir -p ./.electrify/.dist && find ./.electrify/.dist -mindepth 1 -maxdepth 1 -type d -name 'QRLWallet-linux-*' -exec rm -rf {} +",
    "cleanDist:win32": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"New-Item -ItemType Directory -Force .\\\\.electrify\\\\.dist | Out-Null; Get-ChildItem .\\\\.electrify\\\\.dist -Directory -Filter 'QRLWallet-win32-*' | Remove-Item -Recurse -Force\"",
    "electron": "node .scripts/prepare-electron-run.js && electrify",
    "releaseready": "meteor lint",
    "acquire:node": "cp \"$(which node)\" .electrify/bin/node",
    "build": "npm run cleanDist && run-script-os",
    "build:darwin": "npm run cleanDist:darwin && node .scripts/patch-ledger-exports.js && node .scripts/sync-mac-icon.js && electrify package -o .electrify/.dist/ && node .scripts/harden-electron-package.js --platform=darwin",
    "build:linux": "npm run cleanDist:linux && node .scripts/patch-ledger-exports.js && electrify package -o .electrify/.dist/ && node .scripts/harden-electron-package.js --platform=linux",
    "build:win32": "npm run cleanDist:win32 && node .scripts/patch-ledger-exports.js && electrify package -o .electrify/.dist/ && node .scripts/harden-electron-package.js --platform=win32",
    "installer": "run-script-os",
    "installer:darwin": "node .scripts/sync-mac-icon.js && node build-dmg.js",
    "installer:linux": "node build-deb.js",
    "installer:win32": "node build-msi.js",
    "desktop": "meteor-desktop"
  },
  "meteor": {
    "mainModule": {
      "client": "client/main.js",
      "server": "server/main.js"
    }
  }
}
