{
  "name": "QRLWallet",
  "productName": "QRLWallet",
  "projectName": "qrl-wallet",
  "version": "1.9.2",
  "main": "index.js",
  "dependencies": {
    "@electron/packager": "20.3.0",
    "@grpc/grpc-js": "1.14.6",
    "@theqrl/electrify-qrl": "1.1.3",
    "electron": "44.7.0"
  },
  "electronPackager": {
    "icon": {
      "win32": "./assets/qrl.ico",
      "darwin": "./assets/qrl.icns"
    },
    "asar": {
      "unpack": "**/*.node",
      "unpackDir": "{app,bin}"
    },
    "ignore": [
      "^/\\.dist($|/)",
      "^/dist($|/)",
      "/node_modules/electron/",
      "/node_modules/@electron/packager($|/)",
      "/node_modules/electron-packager($|/)",
      "/node_modules/rcedit($|/)",
      "/node_modules/postject($|/)",
      "/node_modules/prettier($|/)"
    ],
    "prune": false,
    "version-string": {
      "CompanyName": "The QRL",
      "LegalCopyright": "Copyright 2020 Die QRL Stiftung, Zug Switzerland",
      "FileDescription": "QRLWallet",
      "OriginalFilename": "QRLWallet.exe",
      "FileVersion": "@version",
      "ProductVersion": "@version",
      "ProductName": "QRLWallet",
      "InternalName": "QRLWallet.exe"
    }
  },
  "scripts": {
    "postinstall": "node ../.scripts/patch-ledger-exports.js"
  },
  "overrides": {
    "shelljs": "0.8.5"
  }
}
